# Copy to ~/.job-application/config.env on the OCI worker and chmod 600.
# The three Cloudflare values must match the Mac worker.
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=

# A shared 32-byte key encoded as base64. Store the same value on the Mac and
# OCI worker. It encrypts document inputs and results before they reach KV.
JOBBY_WORKER_KEY=

# Optional. The service defaults to five seconds between job polls.
JOBBY_DOCUMENT_POLL_SECONDS=5

# Keep one provider run bounded. The worker renews its 15-minute claim every
# five minutes while the provider is active.
JOBBY_DOCUMENT_TIMEOUT_SECONDS=5400

# Keeps static local HTML printing within the E2.1 Micro memory budget.
JOBBY_CHROMIUM_LOW_MEMORY=1
