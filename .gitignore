# Personal data never belongs in the repo
.job-application/
*.pdf
*.docx
dashboard.html
__pycache__/
*.pyc
.DS_Store

# Vercel hosting: the generated module carries real application data,
# and .vercel holds the project link
deploy/api/_dashboard.js
deploy/api/_documents.js
# Delivered resumes and cover letters: real name, phone and street address.
#
# **Anchored, because unanchored it matches any directory of that name at any
# depth.** It silently swallowed apps/web/app/api/applications/, so the write
# endpoint was never committed: it built and answered locally, where the file
# is on disk, and 404'd from the traced bundle in CI. A rule protecting real
# personal data eating source code is the worst way round for both.
/applications/
deploy/.vercel/
# Vercel writes the blob read/write token here
.env.local
deploy/.env*.local
node_modules/
deploy/node_modules/

# Playwright drops traces and page snapshots here. A snapshot of a filled
# application form holds name, phone and home address, so this must never be
# committed even though browser.py now writes them outside the repo.
.playwright-mcp/

# Local board render used for browser-testing the dashboard JS.
.board-preview.html

# Agent screenshots land at the repo root. They are confirmation pages
# carrying a real name and address, and they are not part of the project.
/*.png

# Sourcing sweep scratch: scraped board responses and candidate dumps that a
# scan run leaves behind. Data, not source, and .bodies.json alone is 1.4MB.
.sweep*.json
.sweep*.err
.bodies.json
.candidates.json
.picks.txt

# Agent screenshots, anywhere in the tree. These are filled application forms
# and confirmation pages: names, addresses, phone numbers, and in at least one
# case a completed EEO section with race and gender selected. A screenshot of
# an application form cannot be shown to be safe, so none of them are tracked.
# The scan in tests/test_no_pii.py fails any tracked image by rule.
**/*.png
!assets/**/*.png
!deploy/public/*.png
!apps/web/public/*.png
# The generated brand-pack copy the serverless bundle carries. Written
# only by sync_vercel_renderer.py, out of assets/brand/, which is already
# allowed above. Vercel keeps deploy/public/ out of the function, so the
# board reads its favicons from here instead.
!deploy/assets/**/*.png

# Scratch renders from a run. Same contents as an application: a real
# address, phone and email on every page.
.build/

# apps/web build output. node_modules and .next are produced by npm ci and
# next build; package-lock.json is committed on purpose, because npm ci is what
# makes a CI build reproduce the tree that was tested.
apps/web/node_modules/
apps/web/.next/
apps/web/next-env.d.ts
apps/web/tsconfig.tsbuildinfo
